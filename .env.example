# --- Base de datos ---------------------------------------------------------
# SQLite local. La ruta es relativa a prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# --- Sesiones --------------------------------------------------------------
# Clave de firma de las cookies de sesión. Mínimo 32 caracteres.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="reemplazar-por-una-clave-larga-y-aleatoria"

# --- Aplicación ------------------------------------------------------------
# URL pública/local del sitio. Sin barra final.
APP_URL="http://localhost:3000"

# --- Correo (opcional) -----------------------------------------------------
# Sin estas variables, los enlaces de recuperación se escriben en la consola
# del servidor en desarrollo. En producción, configurar un proveedor real.
RESEND_API_KEY=""
EMAIL_FROM="NEXUS FF <no-reply@nexusff.com>"

# --- Desarrollo ------------------------------------------------------------
# Mostrar el enlace de recuperación en la interfaz (solo desarrollo).
DEV_SHOW_RESET_LINK="true"
